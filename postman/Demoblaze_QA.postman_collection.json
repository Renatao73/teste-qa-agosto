  "item": [
    {
      "name": "01 - Criar novo usuário",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const suffix = Date.now() + '_' + Math.floor(Math.random() * 100000);",
              "pm.environment.set('username', 'qa_postman_' + suffix);",
              "pm.environment.set('password', 'Qa@123456');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Tempo de resposta dentro do limite', function () { pm.expect(pm.response.responseTime).to.be.below(Number(pm.environment.get('responseTimeLimitMs'))); });",
              "pm.test('Cadastro não retorna erro de duplicidade', function () { pm.expect(pm.response.text()).to.not.include('This user already exist.'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
        },
        "url": {
          "raw": "{{apiUrl}}/signup",
          "host": [
            "{{apiUrl}}"
          ],
          "path": [
            "signup"
          ]
        }
      }
    },
