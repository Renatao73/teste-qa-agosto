    {
      "name": "08 - Consultar carrinho",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Tempo de resposta dentro do limite', function () { pm.expect(pm.response.responseTime).to.be.below(Number(pm.environment.get('responseTimeLimitMs'))); });",
              "pm.test('Resposta é uma lista', function () { const body = pm.response.json(); pm.expect(body).to.be.an('array'); });",
              "pm.test('Contrato básico dos itens', function () { const body = pm.response.json(); body.forEach(item => { pm.expect(item).to.have.property('id'); pm.expect(item).to.have.property('cookie'); pm.expect(item).to.have.property('prod_id'); }); });",
              "pm.test('Carrinho contém os três produtos', function () { const ids = pm.response.json().map(i => i.prod_id); pm.expect(ids).to.include.members([1, 10, 8]); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"cookie\": \"{{cartCookie}}\",\n  \"flag\": true\n}"
