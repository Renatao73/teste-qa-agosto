{
  "info": {
    "_postman_id": "a8a07cb9-ccdb-4fb4-8dc0-qa-demoblaze",
    "name": "DemoBlaze QA - Cadastro e Carrinho",
    "description": "Collection criada para o desafio técnico QA: cadastro, login e gerenciamento básico de carrinho.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
