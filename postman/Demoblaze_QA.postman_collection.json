    {
      "name": "05 - Adicionar produto 1 ao carrinho",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.environment.get('cartCookie')) { pm.environment.set('cartCookie', 'user=qa_cart_' + Date.now()); }",
              "pm.environment.set('requestId', 'qa-' + Date.now() + '-' + Math.floor(Math.random() * 100000));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Tempo de resposta dentro do limite', function () { pm.expect(pm.response.responseTime).to.be.below(Number(pm.environment.get('responseTimeLimitMs'))); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": \"{{requestId}}\",\n  \"cookie\": \"{{cartCookie}}\",\n  \"prod_id\": 1,\n  \"flag\": true\n}"
        },
        "url": {
          "raw": "{{apiUrl}}/addtocart",
          "host": [
            "{{apiUrl}}"
          ],
          "path": [
            "addtocart"
          ]
        }
      }
    },
